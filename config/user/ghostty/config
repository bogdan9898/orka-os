# OrkaOS: Ghostty terminal config (from Omarchy v3.8.4, MIT).
# All options: `ghostty +show-config --default --docs`. Check this file with
# `ghostty +validate-config`. Changes apply to new windows (or CTRL+SHIFT+,).

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor (all shell-integration features must be set on one line)
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# Keys
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter and Alt+Shift+Enter as CSI-u, so TUIs and tmux can tell them apart.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slightly slower mouse scrolling
mouse-scroll-multiplier = 0.95

# Avoids slowness on Hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
