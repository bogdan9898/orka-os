# ---------------------------------------------------------------------------

finish() {
  step "Finishing"
  # DNS through systemd-resolved (arch-chroot bind-mounts resolv.conf, so set it last).
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
  cp "$LOG" "$TARGET/var/log/orka-install.log"
  sync
  umount -R "$TARGET"
  step "OrkaOS is installed"
  info "Remove the USB stick and reboot, then log in on the login screen."
}

main() {
  if [[ "${1:-}" == --list-disks ]]; then list_disks; return; fi
  : >"$LOG"
  preflight
  ask
  plan_partitions
  confirm
  partition
  format_and_mount
  prepare_boot
  install_packages
  configure_system
  finish_bootloader
  install_selftest
  finish
  if interactive && gum confirm "Reboot now?"; then systemctl reboot; fi
}

main "$@"
