#!/usr/bin/env bash
# OrkaOS installer. Runs in the live ISO and installs fully offline from the
# local package repo in /opt/orka/repo.
#
# Interactive by default (gum). For unattended installs set ORKA_UNATTENDED=1
# and provide:
#   ORKA_DISK       target disk, e.g. /dev/vda or /dev/nvme0n1
#   ORKA_MODE       "free" (use the largest free space, keep everything else)
#                   or "wipe" (erase the whole disk)
#   ORKA_HOSTNAME, ORKA_USER, ORKA_PASSWORD
# Optional:
#   ORKA_TIMEZONE (Europe/Bucharest), ORKA_LOCALE (en_US.UTF-8), ORKA_KEYMAP (us)
#   ORKA_TEST=1     test build: kernel log + self-test report on the serial port
#   ORKA_ERASE_NONEMPTY=1  allow "wipe" on a disk that has partitions (unattended only)

set -euo pipefail

ORKA=/opt/orka
REPO="$ORKA/repo"
SRC="$ORKA/src"
TARGET=/mnt
LOG=/tmp/orka-install.log
ESP_SIZE_MIB=2048
MIN_ROOT_GIB=20

: "${ORKA_TIMEZONE:=Europe/Bucharest}"
: "${ORKA_LOCALE:=en_US.UTF-8}"
: "${ORKA_KEYMAP:=us}"
: "${ORKA_TEST:=0}"
: "${ORKA_UNATTENDED:=0}"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

BLUE=$'\e[1;38;2;23;147;209m'; BOLD=$'\e[1m'; RED=$'\e[1;31m'; DIM=$'\e[2m'; RST=$'\e[0m'

step() { printf '%s==>%s %s%s%s\n' "$BLUE" "$RST" "$BOLD" "$*" "$RST" | tee -a "$LOG" >&2; }
info() { printf '    %s\n' "$*" | tee -a "$LOG" >&2; }
die()  { printf '%sERROR:%s %s\n' "$RED" "$RST" "$*" | tee -a "$LOG" >&2; exit 1; }

# Run a command, sending its output to the log only.
run() { printf '%s$ %s%s\n' "$DIM" "$*" "$RST" >>"$LOG"; "$@" >>"$LOG" 2>&1; }

interactive() { [[ "$ORKA_UNATTENDED" != 1 ]]; }

banner() {
  clear
  printf '%s' "$BLUE"
  cat <<'EOF'

     ___       _          ___  ____
    / _ \ _ __| | ____ _ / _ \/ ___|
   | | | | '__| |/ / _` | | | \___ \
   | |_| | |  |   < (_| | |_| |___) |
    \___/|_|  |_|\_\__,_|\___/|____/

EOF
  printf '%s   Offline installer%s\n\n' "$BOLD" "$RST"
}

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

preflight() {
  [[ $EUID -eq 0 ]] || die "run as root"
  [[ -d /sys/firmware/efi/efivars ]] || die "not booted in UEFI mode"
  [[ -f "$REPO/orka.db.tar.zst" ]] || die "offline repo not found at $REPO"
  command -v gum >/dev/null || ! interactive || die "gum is missing"

  # The live system initializes its pacman keyring at boot (pacman-init);
  # package signatures are checked against it.
  local i
  for i in $(seq 120); do
    systemctl is-active -q pacman-init.service && break
    ((i == 1)) && info "waiting for the pacman keyring to be initialized..."
    sleep 1
  done
  systemctl is-active -q pacman-init.service || die "pacman keyring initialization did not finish"
}

# ---------------------------------------------------------------------------
# Questions
# ---------------------------------------------------------------------------

# The disk the live system was booted from (USB stick), never a target.
boot_disk() {
  local src
  src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  [[ -n "$src" ]] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

# What is on a disk, for the disk menu: "empty", or e.g. "Windows, 3 partitions".
disk_contents() {
  local disk="$1" parts fstypes what=()
  parts="$(lsblk -lnpo TYPE "$disk" | grep -c '^part' || true)"
  ((parts)) || { echo "empty"; return; }
  fstypes="$(lsblk -lnpo FSTYPE,PARTTYPE,PARTLABEL "$disk" | tr '[:upper:]' '[:lower:]')"
  grep -qE 'ntfs|microsoft|e3c9e316-0b5c-4db8-817d-f92df00215ae' <<<"$fstypes" && what+=("Windows")
  grep -qE 'orka_root|orkaos' <<<"$fstypes" && what+=("OrkaOS")
  grep -qE '(^| )(btrfs|ext4|xfs|f2fs)( |$)' <<<"$fstypes" && ! printf '%s\n' "${what[@]}" | grep -q OrkaOS && what+=("Linux")
  what+=("$parts partition$( ((parts > 1)) && echo s)")
  local IFS=,; echo "${what[*]}" | sed 's/,/, /g'
}


list_disks() {
  local boot name size model
  boot="$(boot_disk || true)"
  while read -r name size model; do
    [[ "/dev/$boot" == "$name" ]] && continue
    printf '%s  %s  %s  [%s]\n' "$name" "$size" "${model:-disk}" "$(disk_contents "$name")"
  done < <(lsblk -dpno NAME,SIZE,MODEL,TYPE,RO | awk '$NF=="0" && $(NF-1)=="disk" { NF-=2; print }')
}

# Largest free region of a disk: prints "start_sector end_sector" (512-byte sectors).
largest_free() {
  sfdisk --list-free --bytes "$1" 2>/dev/null |
    awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { if ($3 > best) { best=$3; s=$1; e=$2 } } END { if (best) print s, e }'
}

ask() {
  local disks choice
  if interactive; then
    banner
    gum style --foreground 7 "This installs OrkaOS from the packages on this USB stick. No network is needed."
    echo

    mapfile -t disks < <(list_disks)
    ((${#disks[@]})) || die "no disks found"
    choice="$(gum choose --header "Install to which disk?" "${disks[@]}")" || exit 1
    ORKA_DISK="${choice%% *}"

    choice="$(gum choose --header "How should the disk be used?" \
      "free: use the free space, keep Windows and everything else" \
      "wipe: erase the whole disk")" || exit 1
    ORKA_MODE="${choice%%:*}"

    ORKA_HOSTNAME="$(gum input --header "Computer name (hostname)" --value "orka")" || exit 1
    ORKA_USER="$(gum input --header "Username" --placeholder "lowercase, e.g. bogdan")" || exit 1
    while :; do
      ORKA_PASSWORD="$(gum input --password --header "Password for $ORKA_USER (also used for sudo and the KWallet)")" || exit 1
      local again; again="$(gum input --password --header "Repeat the password")" || exit 1
      [[ -n "$ORKA_PASSWORD" && "$ORKA_PASSWORD" == "$again" ]] && break
      gum style --foreground 1 "Passwords are empty or don't match, try again."
    done
  fi

  [[ -b "${ORKA_DISK:-}" ]] || die "ORKA_DISK is not a block device: ${ORKA_DISK:-unset}"
  [[ "${ORKA_MODE:-}" == free || "${ORKA_MODE:-}" == wipe ]] || die "ORKA_MODE must be 'free' or 'wipe'"
  [[ "${ORKA_HOSTNAME:-}" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "invalid hostname: ${ORKA_HOSTNAME:-}"
  [[ "${ORKA_USER:-}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username: ${ORKA_USER:-}"
  [[ -n "${ORKA_PASSWORD:-}" ]] || die "ORKA_PASSWORD is empty"
}

# ---------------------------------------------------------------------------
# Partitioning
# ---------------------------------------------------------------------------

plan_partitions() {
  local sector_mib=2048 start end  # 1 MiB = 2048 sectors of 512 bytes

  if [[ "$ORKA_MODE" == wipe ]]; then
    start=2048
    end=$(( $(blockdev --getsz "$ORKA_DISK") - 34 ))   # leave room for the backup GPT
  else
    read -r start end < <(largest_free "$ORKA_DISK") || true
    [[ -n "${start:-}" ]] || die "no free space on $ORKA_DISK"
  fi

  # Align to 1 MiB.
  ESP_START=$(( (start + sector_mib - 1) / sector_mib * sector_mib ))
  ESP_END=$(( ESP_START + ESP_SIZE_MIB * sector_mib - 1 ))
  ROOT_START=$(( ESP_END + 1 ))
  ROOT_END=$(( (end + 1) / sector_mib * sector_mib - 1 ))

  local root_gib=$(( (ROOT_END - ROOT_START + 1) / 2048 / 1024 ))
  (( root_gib >= MIN_ROOT_GIB )) || die "not enough space: ${root_gib} GiB for the system (need ${MIN_ROOT_GIB} GiB + 2 GiB boot)"
  ROOT_GIB=$root_gib
}

# Partitions of a disk, for the erase warning: "  vda1  100M  vfat  EFI".
disk_partitions() {
  lsblk -lnpo NAME,SIZE,FSTYPE,LABEL,PARTLABEL,TYPE "$1" |
    awk '$NF=="part" { $NF=""; sub("^/dev/", "", $1); printf "  %s\n", $0 }'
}

confirm() {
  local what contents warning=()
  contents="$(disk_contents "$ORKA_DISK")"
  if [[ "$ORKA_MODE" == wipe ]]; then
    what="ERASE the whole disk $ORKA_DISK"
    if [[ "$contents" != empty ]]; then
      warning=("WARNING: $ORKA_DISK is not empty [$contents]." "Everything on it will be permanently deleted:" "")
      mapfile -t -O 3 warning < <(disk_partitions "$ORKA_DISK")
    fi
  else
    what="create 2 partitions in the free space of $ORKA_DISK (nothing else is touched)"
  fi

  if interactive; then
    echo
    gum style --border rounded --padding "0 2" --border-foreground 4 \
      "Disk:      $ORKA_DISK ($(lsblk -dno SIZE,MODEL "$ORKA_DISK" | xargs)) [$contents]" \
      "Action:    $what" \
      "Partitions: 2 GiB boot (FAT32) + ${ROOT_GIB} GiB system (Btrfs)" \
      "Hostname:  $ORKA_HOSTNAME" \
      "User:      $ORKA_USER" \
      "Timezone:  $ORKA_TIMEZONE, $ORKA_LOCALE, keyboard $ORKA_KEYMAP"
    if ((${#warning[@]})); then
      echo
      gum style --border thick --padding "0 2" --border-foreground 1 --foreground 1 --bold "${warning[@]}"
    fi
    echo
    if [[ "$ORKA_MODE" == wipe ]]; then
      local typed
      typed="$(gum input --header "Type the disk name ($ORKA_DISK) to erase it" --placeholder "$ORKA_DISK")" || exit 1
      [[ "$typed" == "$ORKA_DISK" ]] || die "not confirmed"
    else
      gum confirm "Install OrkaOS now?" || exit 1
    fi
  else
    info "unattended: $what [$contents]"
    if ((${#warning[@]})) && [[ "${ORKA_ERASE_NONEMPTY:-0}" != 1 ]]; then
      die "$ORKA_DISK is not empty [$contents]; set ORKA_ERASE_NONEMPTY=1 to erase it anyway"
    fi
  fi
}

# Partition device for a partition number: /dev/vda + 1 -> /dev/vda1, nvme0n1 -> nvme0n1p1.
part_dev() { if [[ "$1" =~ [0-9]$ ]]; then echo "${1}p$2"; else echo "$1$2"; fi; }

partition() {
  step "Partitioning $ORKA_DISK"
  if [[ "$ORKA_MODE" == wipe ]]; then
    run wipefs --all "$ORKA_DISK"
    run sgdisk --zap-all "$ORKA_DISK"
  fi

  # Partition number 0 = "first unused number"; find them afterwards by start sector.
  run sgdisk -n "0:$ESP_START:$ESP_END" -t "0:ef00" -c "0:ORKA_EFI" "$ORKA_DISK"
  run sgdisk -n "0:$ROOT_START:$ROOT_END" -t "0:8304" -c "0:ORKA_ROOT" "$ORKA_DISK"
  run partprobe "$ORKA_DISK"
  udevadm settle

  local n_esp n_root
  n_esp="$(partx -g -o NR,START "$ORKA_DISK" | awk -v s="$ESP_START" '$2==s {print $1}')"
  n_root="$(partx -g -o NR,START "$ORKA_DISK" | awk -v s="$ROOT_START" '$2==s {print $1}')"
  [[ -n "$n_esp" && -n "$n_root" ]] || die "could not find the new partitions"
  ESP="$(part_dev "$ORKA_DISK" "$n_esp")"
  ROOT="$(part_dev "$ORKA_DISK" "$n_root")"
  [[ -b "$ESP" && -b "$ROOT" ]] || die "new partitions not found ($ESP, $ROOT)"
  info "boot: $ESP, system: $ROOT"
}

format_and_mount() {
  step "Creating file systems"
  run mkfs.fat -F 32 -n ORKA_EFI "$ESP"
  run mkfs.btrfs -f -L orkaos "$ROOT"

  # Subvolumes: @ is / (snapshotted); home, logs and the package cache are
  # separate so rolling back / doesn't touch them.
  run mount "$ROOT" "$TARGET"
  local sv
  for sv in @ @home @log @pkg; do run btrfs subvolume create "$TARGET/$sv"; done
  run umount "$TARGET"

  local opts=noatime,compress=zstd
  run mount -o "$opts,subvol=@" "$ROOT" "$TARGET"
  run mount --mkdir -o "$opts,subvol=@home" "$ROOT" "$TARGET/home"
  run mount --mkdir -o "$opts,subvol=@log" "$ROOT" "$TARGET/var/log"
  run mount --mkdir -o "$opts,subvol=@pkg" "$ROOT" "$TARGET/var/cache/pacman/pkg"
  run mount --mkdir -o umask=0077 "$ESP" "$TARGET/boot"
}

# ---------------------------------------------------------------------------
# Boot setup (before packages)
# ---------------------------------------------------------------------------
#
# limine-mkinitcpio-hook takes over kernel installation: whenever a kernel is
# installed or updated, it builds the initramfs, copies kernel + initramfs to
# the ESP and writes the boot entry into /boot/limine.conf. Its config has to
# exist before the package is installed, so the entries are right from the
# first package transaction.

prepare_boot() {
  step "Preparing the boot configuration"
  local root_uuid cmdline
  root_uuid="$(blkid -s UUID -o value "$ROOT")"
  # quiet splash: the OrkaOS boot screen (Plymouth) instead of kernel messages.
  cmdline="root=UUID=$root_uuid rootflags=subvol=@ rw quiet splash"
  # Test installs also log to the serial port; Plymouth would switch to text
  # mode for it unless told to ignore serial consoles.
  [[ "$ORKA_TEST" == 1 ]] && cmdline="root=UUID=$root_uuid rootflags=subvol=@ rw quiet splash plymouth.ignore-serial-consoles console=ttyS0,115200 console=tty0"

  install -d "$TARGET/etc/default" "$TARGET/etc/mkinitcpio.conf.d"
  systemd-id128 new >"$TARGET/etc/machine-id"
  echo "KEYMAP=$ORKA_KEYMAP" >"$TARGET/etc/vconsole.conf"

  cat >"$TARGET/etc/default/limine" <<EOF
# OrkaOS: limine-entry-tool settings (see /etc/limine-entry-tool.conf for all options).
TARGET_OS_NAME="OrkaOS"
ESP_PATH="/boot"
KERNEL_CMDLINE[default]="$cmdline"
ENABLE_UKI=no
ENABLE_LIMINE_FALLBACK=yes
FIND_BOOTLOADERS=yes
BOOT_ORDER="linux-zen, *, *fallback, Snapshots"
MAX_SNAPSHOT_ENTRIES=5
EOF

  # Boot menu wallpaper (branding/limine, "Deep water"), on the ESP where
  # Limine can read it.
  install -Dm644 "$SRC/branding/limine/wallpaper.jpg" "$TARGET/boot/orka/wallpaper.jpg"

  # Global menu options; the OS entries are appended by limine-entry-tool.
  cat >"$TARGET/boot/limine.conf" <<'EOF'
# OrkaOS boot menu. Entries below are managed by limine-entry-tool
# (limine-update); see https://github.com/limine-bootloader/limine/blob/trunk/CONFIG.md
timeout: 3
# Entry 1 is the "OrkaOS" folder; 2 is its first kernel (linux-zen).
default_entry: 2
hash_mismatch_panic: no

# Look: the OrkaOS "Deep water" theme (themes/orka). Colors are RRGGBB;
# term_background is TTRRGGBB, TT = transparency (00 opaque, ff invisible):
# invisible, so the whole wallpaper shows behind the menu.
wallpaper: boot():/orka/wallpaper.jpg
wallpaper_style: stretched
backdrop: 0d1620
interface_branding: OrkaOS
interface_branding_colour: 3fa7d6
interface_help_colour: 7f8b97
interface_help_colour_bright: 7fd1c7
term_background: ff0d1620
term_foreground: dce6ef
term_background_bright: 2e3d4d
term_foreground_bright: f1f6fa
term_palette: 1a2733;ef6461;8cc98a;e8c26b;3fa7d6;b393e0;7fd1c7;b7c5d3
term_palette_bright: 4a5b6c;ff8a85;a8dba5;f2d48f;6cc0e8;c9b0ee;a3e3da;f1f6fa
EOF

  # Boot screen (Plymouth, branding/plymouth): the OrkaOS logo above ripples on
  # the boot menu's background. In place before the packages, so the first
  # initramfs already has it.
  local theme="$TARGET/usr/share/plymouth/themes/orka"
  install -d "$theme" "$TARGET/etc/plymouth"
  install -m644 "$SRC"/branding/plymouth/orka/* "$theme/"
  cat >"$TARGET/etc/plymouth/plymouthd.conf" <<'EOF'
# OrkaOS boot screen (/usr/share/plymouth/themes/orka)
[Daemon]
Theme=orka
ShowDelay=0
DeviceTimeout=8
EOF

  # Initramfs: systemd-based, the boot screen, plus the overlay hook that
  # makes read-only Btrfs snapshots bootable (from limine-mkinitcpio-hook).
  cat >"$TARGET/etc/mkinitcpio.conf.d/orka.conf" <<'EOF'
# OrkaOS initramfs hooks
HOOKS=(base systemd plymouth autodetect microcode modconf kms keyboard sd-vconsole block filesystems fsck sd-btrfs-overlayfs)
EOF
}

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

read_list() { sed -e 's/#.*//' "$1" | tr -s ' \t' '\n' | grep -v '^$' || true; }

PACMAN_CONF=/tmp/pacman-offline.conf

# Installed only after Snapper is configured.
LATE_PACKAGES=(snap-pac)

write_pacman_conf() {
  cat >"$PACMAN_CONF" <<EOF
[options]
Architecture = auto
# Official packages keep their signatures (checked against the live keyring);
# our own AUR builds are unsigned.
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

[orka]
SigLevel = Optional TrustAll
Server = file://$REPO
EOF
}

install_packages() {
  step "Installing packages (offline)"
  write_pacman_conf
  local pkgs
  mapfile -t pkgs < <(read_list "$SRC/packages.txt"; read_list "$SRC/packages-aur.txt")
  mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | grep -vxF -f <(printf '%s\n' "${LATE_PACKAGES[@]}"))
  info "${#pkgs[@]} packages + dependencies"
  # -K: fresh keyring in the target, -M: don't copy the live mirrorlist.
  pacstrap -C "$PACMAN_CONF" -K -M "$TARGET" "${pkgs[@]}" >>"$LOG" 2>&1 ||
    { tail -15 "$LOG" >&2; die "package installation failed (log: $LOG)"; }
}

install_late_packages() {
  pacstrap -C "$PACMAN_CONF" -M "$TARGET" "${LATE_PACKAGES[@]}" >>"$LOG" 2>&1 ||
    { tail -15 "$LOG" >&2; die "installing ${LATE_PACKAGES[*]} failed (log: $LOG)"; }
  info "$(arch-chroot "$TARGET" pacman -Q | wc -l) packages installed"
}

# ---------------------------------------------------------------------------
# System configuration
# ---------------------------------------------------------------------------

configure_system() {
  step "Configuring the system"
  genfstab -U "$TARGET" >>"$TARGET/etc/fstab"

  # Files shipped with the installer (network, zram, mirrors, first-boot setup).
  cp -r --no-preserve=mode,ownership "$SRC/installer/target/." "$TARGET/"
  chmod 755 "$TARGET"/usr/local/bin/orka-*

  echo "$ORKA_HOSTNAME" >"$TARGET/etc/hostname"
  cat >"$TARGET/etc/hosts" <<EOF
127.0.0.1  localhost
::1        localhost
127.0.1.1  $ORKA_HOSTNAME.localdomain $ORKA_HOSTNAME
EOF
  echo "LANG=$ORKA_LOCALE" >"$TARGET/etc/locale.conf"
  sed -i "s/^#\(${ORKA_LOCALE//./\\.} \)/\1/" "$TARGET/etc/locale.gen"

  arch-chroot "$TARGET" /bin/bash -euo pipefail >>"$LOG" 2>&1 <<EOF
ln -sf /usr/share/zoneinfo/$ORKA_TIMEZONE /etc/localtime
hwclock --systohc
locale-gen

useradd -m -G wheel,docker -s /bin/bash "$ORKA_USER"
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
passwd -l root

# Snapper: snapshots of / only (/home is user data; rolling it back loses work).
snapper --no-dbus -c root create-config /
sed -i -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
       -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
       -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' /etc/snapper/configs/root
btrfs quota disable / || true

systemctl enable systemd-networkd systemd-resolved systemd-timesyncd iwd \
  bluetooth docker avahi-daemon fstrim.timer plocate-updatedb.timer \
  snapper-cleanup.timer limine-snapper-sync.service orka-firstboot.service orka-windows-entry.service \
  greetd
# The OrkaOS shell, for every user's Hyprland session.
systemctl --global enable orka-shell.service
EOF
  printf '%s:%s\n' "$ORKA_USER" "$ORKA_PASSWORD" | arch-chroot "$TARGET" chpasswd

  # KWallet: unlock (and on first login create) the wallet with the login
  # password, on the login screen (greetd) and on the consoles (login).
  local pamf
  for pamf in greetd login; do
    if ! grep -q pam_kwallet5 "$TARGET/etc/pam.d/$pamf"; then
      sed -i '/^auth.*system-local-login/a auth       optional     pam_kwallet5.so' "$TARGET/etc/pam.d/$pamf"
      echo 'session    optional     pam_kwallet5.so auto_start' >>"$TARGET/etc/pam.d/$pamf"
    fi
  done

  # Snapshots before/after every pacman transaction, now that Snapper is set up.
  install_late_packages

  # A copy of the OrkaOS sources, for re-running parts of the setup later.
  install -d "$TARGET/opt/orka"
  cp -r "$SRC" "$TARGET/opt/orka/src"

  install_desktop
}

# Hyprland, bash, tmux and git defaults, orka-* commands, and the user's dotfiles.
install_desktop() {
  step "Setting up the desktop (Hyprland) and shell"
  install -d "$TARGET/usr/share/orka"
  local d
  for d in hypr bash tmux git; do
    rm -rf "$TARGET/usr/share/orka/$d"
    cp -r --no-preserve=mode,ownership "$SRC/config/$d" "$TARGET/usr/share/orka/$d"
  done
  # The desktop shell (Quickshell, orka-shell.service), the built-in themes,
  # OrkaOS's own apps (apps/calculator: orka-calculator), and the folder for
  # OrkaOS wallpapers (yours go in ~/Pictures/Wallpapers).
  for d in shell themes apps; do
    rm -rf "$TARGET/usr/share/orka/$d"
    cp -r --no-preserve=mode,ownership "$SRC/$d" "$TARGET/usr/share/orka/$d"
  done
  install -d "$TARGET/usr/share/orka/wallpapers"
  install -m755 "$SRC"/bin/orka-* "$TARGET/usr/local/bin/"
  install_branding
  arch-chroot "$TARGET" runuser -u "$ORKA_USER" -- env HOME="/home/$ORKA_USER" \
    /usr/local/bin/orka-setup-user >>"$LOG" 2>&1 || die "orka-setup-user failed (log: $LOG)"
  install_nvim_bundle
  info "Login screen at boot (greetd); Hyprland starts after logging in"
}

# Neovim plugins, parsers and language servers, prepared by `build.sh nvim`,
# so LazyVim needs no downloads on the first start.
# The OrkaOS name and logo (branding/): os-release (kept by a pacman hook,
# /etc/pacman.d/hooks/orka-os-release.hook), the text console banner, the
# logo files and app icon, fastfetch's defaults.
install_branding() {
  local b="$TARGET/usr/share/orka/branding"
  install -d "$b/fastfetch"
  install -m644 "$SRC"/branding/logo/orkaos-*.svg "$SRC/branding/os-release" "$b/"
  install -m644 "$SRC"/branding/fastfetch/orkaos.png "$SRC"/branding/fastfetch/orkaos.txt "$b/fastfetch/"
  install -m644 "$SRC/branding/os-release" "$TARGET/usr/lib/os-release"
  printf '\e[38;2;63;167;214mOrkaOS 1.0\e[0m \\r (\\l)\n\n' >"$TARGET/etc/issue"
  install -Dm644 "$SRC/branding/logo/orkaos-badge.svg" "$TARGET/usr/share/icons/hicolor/scalable/apps/orkaos.svg"
  arch-chroot "$TARGET" gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >>"$LOG" 2>&1 || true
  install -Dm644 "$SRC/branding/fastfetch/config.jsonc" "$TARGET/etc/xdg/fastfetch/config.jsonc"
}

install_nvim_bundle() {
  local bundle="$ORKA/nvim-data.tar.zst" share="/home/$ORKA_USER/.local/share" from
  if [[ ! -f "$bundle" ]]; then
    info "No Neovim bundle on this ISO: plugins download on the first start"
    return 0
  fi
  install -d "$TARGET$share"
  rm -rf "$TARGET$share/nvim"
  tar -C "$TARGET$share" --zstd -xf "$bundle"
  # Mason wrapper scripts contain the build machine's path; point them here.
  from="$(cat "$TARGET$share/nvim/.orka-build-path")"
  rm "$TARGET$share/nvim/.orka-build-path"
  grep -rIlFZ "$from" "$TARGET$share/nvim" | xargs -0r sed -i "s#$from#$share/nvim#g"
  arch-chroot "$TARGET" chown -R "$ORKA_USER:" "/home/$ORKA_USER/.local"
  info "Neovim: LazyVim plugins installed"
}

# ---------------------------------------------------------------------------
# Boot loader (Limine)
# ---------------------------------------------------------------------------

finish_bootloader() {
  step "Finishing the Limine boot loader"
  # The package hooks normally created the entries already; make sure.
  grep -q '^/+\?OrkaOS' "$TARGET/boot/limine.conf" || arch-chroot "$TARGET" limine-update >>"$LOG" 2>&1
  grep -q '^/+\?OrkaOS' "$TARGET/boot/limine.conf" || die "no OrkaOS boot entry in /boot/limine.conf"

  # UEFI boot entry + binary (limine-install skips what is already there).
  arch-chroot "$TARGET" limine-install >>"$LOG" 2>&1 || info "limine-install reported a problem (see $LOG)"

  # Windows on other disks (also re-checked at every boot by orka-windows-entry.service,
  # for Windows disks that are disconnected during the install).
  local msg
  msg="$(arch-chroot "$TARGET" /usr/local/bin/orka-windows-entry 2>>"$LOG")" || info "Windows scan failed (see $LOG)"
  [[ -n "$msg" ]] && info "$msg"

  info "boot menu: $(grep -E '^/+' "$TARGET/boot/limine.conf" | sed 's/^ *//' | paste -sd'|' | sed 's/|/, /g')"
}

