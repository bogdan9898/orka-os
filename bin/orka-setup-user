#!/bin/bash
# Set up OrkaOS dotfiles for the current user. Safe to re-run: existing files
# are never overwritten (new defaults are written next to them as *.orka-new).
#   orka-setup-user [--src DIR]   (DIR defaults to /opt/orka/src)
set -euo pipefail
src=/opt/orka/src
[[ "${1:-}" == --src ]] && src="$2"
user_cfg="$src/config/user"

install_file() {   # install_file <from> <to> [stock file that may be replaced]
  local from="$1" to="$2" stock="${3:-}"
  mkdir -p "$(dirname "$to")"
  if [[ ! -e "$to" ]] || { [[ -n "$stock" ]] && cmp -s "$stock" "$to"; }; then
    cp "$from" "$to"
  elif ! cmp -s "$from" "$to"; then
    cp "$from" "$to.orka-new"
  fi
}

# Hyprland + hypridle
for f in "$user_cfg"/hypr/*; do
  install_file "$f" "$HOME/.config/hypr/$(basename "$f")"
done

# Shell and terminal. useradd copies Arch's stock ~/.bashrc from /etc/skel;
# that one is replaced, a .bashrc you changed is kept.
install_file "$user_cfg/bash/bashrc" "$HOME/.bashrc" /etc/skel/.bashrc
install_file "$user_cfg/starship.toml" "$HOME/.config/starship.toml"
install_file "$user_cfg/ghostty/config" "$HOME/.config/ghostty/config"
install_file "$user_cfg/tmux/tmux.conf" "$HOME/.config/tmux/tmux.conf"
install_file "$user_cfg/git/config" "$HOME/.config/git/config"

# Neovim (LazyVim). The plugins themselves are unpacked by the installer.
while IFS= read -r -d '' f; do
  install_file "$f" "$HOME/.config/nvim/${f#"$user_cfg/nvim/"}"
done < <(find "$user_cfg/nvim" -type f -print0)

# Start Hyprland after logging in on the first console (tty1).
profile="$HOME/.bash_profile"
touch "$profile"
if ! grep -q 'orka: start Hyprland' "$profile"; then
  cat >>"$profile" <<'PROFILE'

# orka: start Hyprland on tty1 (other consoles stay plain shells)
if [[ -z "${WAYLAND_DISPLAY:-}" && "$(tty)" == /dev/tty1 ]] && uwsm check may-start; then
  exec uwsm start hyprland.desktop
fi
PROFILE
fi

# Standard folders (Pictures, Videos, ...), used by the screenshot tools.
xdg-user-dirs-update 2>/dev/null || true
