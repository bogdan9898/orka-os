#!/bin/bash
# Set up OrkaOS dotfiles for the current user. Safe to re-run: existing files
# are never overwritten (new defaults are written next to them as *.orka-new).
#   orka-setup-user [--src DIR]   (DIR defaults to /opt/orka/src)
set -euo pipefail
src=/opt/orka/src
[[ "${1:-}" == --src ]] && src="$2"
user_cfg="$src/config/user"

install_file() {   # install_file <from> <to>
  local from="$1" to="$2"
  mkdir -p "$(dirname "$to")"
  if [[ ! -e "$to" ]]; then
    cp "$from" "$to"
  elif ! cmp -s "$from" "$to"; then
    cp "$from" "$to.orka-new"
  fi
}

# Hyprland + hypridle
for f in "$user_cfg"/hypr/*; do
  install_file "$f" "$HOME/.config/hypr/$(basename "$f")"
done

# Start Hyprland after logging in on the first console (tty1).
profile="$HOME/.bash_profile"
touch "$profile"
if ! grep -q 'orka: start Hyprland' "$profile"; then
  cat >>"$profile" <<'PROFILE'

# orka: start Hyprland on tty1 (other consoles stay plain shells)
if [[ -z "${WAYLAND_DISPLAY:-}" && "$(tty)" == /dev/tty1 ]] && uwsm check may-start; then
  exec uwsm start hyprland.desktop
fi
PROFILE
fi

# Standard folders (Pictures, Videos, ...), used by the screenshot tools.
xdg-user-dirs-update 2>/dev/null || true
