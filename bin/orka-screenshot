#!/bin/bash
# Screenshots: orka-screenshot region|screen|text
#   region  select an area, open it in satty (annotate, copy, save)
#   screen  the focused monitor, open it in satty
#   text    select an area, OCR it (tesseract), copy the text
set -euo pipefail
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-region}" in
  region)
    area="$(slurp)" || exit 0
    grim -g "$area" - | satty --filename - --output-filename "$file" --copy-command wl-copy --early-exit ;;
  screen)
    output="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
    grim -o "$output" - | satty --filename - --output-filename "$file" --copy-command wl-copy --early-exit ;;
  text)
    area="$(slurp)" || exit 0
    grim -g "$area" - | tesseract - - -l eng 2>/dev/null | wl-copy ;;
  *) echo "usage: orka-screenshot region|screen|text" >&2; exit 1 ;;
esac
