#!/bin/bash
# Add a Limine boot entry for every Windows installation found on any disk.
# Looks for Windows Boot Manager on all EFI system partitions except ours,
# and appends an entry to /boot/limine.conf if it isn't there yet.
# Runs at every boot (orka-windows-entry.service), so Windows disks that were
# disconnected during the install get their entry once they're back.
set -euo pipefail

CONF=/boot/limine.conf
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
[[ -f "$CONF" ]] || { echo "no $CONF" >&2; exit 1; }

own_esp="$(findmnt -no SOURCE /boot || true)"
tmp="$(mktemp -d)"
trap 'umount -q "$tmp" 2>/dev/null || true; rmdir "$tmp"' EXIT

added=0
while read -r part type; do
  [[ "${type,,}" == "$ESP_GUID" && "$part" != "$own_esp" ]] || continue
  mount -o ro "$part" "$tmp" 2>/dev/null || continue
  if [[ -f "$tmp/EFI/Microsoft/Boot/bootmgfw.efi" ]]; then
    uuid="$(lsblk -no PARTUUID "$part")"
    if ! grep -q "guid($uuid)" "$CONF"; then
      printf '\n/Windows\n    protocol: efi\n    path: guid(%s):/EFI/Microsoft/Boot/bootmgfw.efi\n' "$uuid" >>"$CONF"
      echo "added a Windows entry for $part ($uuid)"
      added=1
    fi
  fi
  umount "$tmp"
done < <(lsblk -lnpo NAME,PARTTYPE)

# Keep a config checksum enrolled in the Limine binary in sync, if enabled.
if ((added)) && command -v limine-enroll-config >/dev/null && grep -q '^ENABLE_ENROLL_LIMINE_CONFIG=yes' /etc/default/limine 2>/dev/null; then
  limine-enroll-config
fi
exit 0
