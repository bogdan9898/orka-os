#!/bin/bash
# Toggle the warm night light (hyprsunset). The temperature is set in
# Settings → Night light (`.nightlight.temperature`, default 4000 K).
if pgrep -x hyprsunset >/dev/null; then
  orka-settings set .nightlight.on false
  orka-osd night "Night light off" 2>/dev/null
else
  orka-settings set .nightlight.on true
  orka-osd night "Night light on" 2>/dev/null
fi
