#!/bin/bash
# OrkaOS settings: ~/.config/orka/settings.json, read by the shell and applied
# to Hyprland, apps (Ghostty, Neovim, GTK, Qt, btop), cursor, wallpaper and
# night light. The settings app (SUPER + ALT + SPACE) uses this; so can you:
#
#   orka-settings get [.path]                print a value (or everything)
#   orka-settings set .path <json>           change a value and apply it, e.g.
#       orka-settings set .appearance.dark '"tokyo-night"'   (theme for dark mode)
#       orka-settings set .cursor '{"theme":"Bibata-Modern-Ice","size":32}'
#       orka-settings set .keyboard.layouts '["us","ro"]'
#   orka-settings mode [dark|light|toggle]   print or switch dark/light mode
#   orka-settings apply [all|theme|apps|cursor|hyprland|wallpaper|nightlight]
#   orka-settings themes                     installed themes (JSON)
#   orka-settings cursors                    installed cursor themes (JSON)
#   orka-settings about                      system information (JSON)
#
# Generated files (don't edit, they're rewritten): ~/.config/orka/current/
#   theme.json     the current theme (read by the shell and Neovim)
#   hyprland.lua   theme colors, monitors, keyboard, cursor, animations (orka/settings.lua)
#   ghostty.conf   the terminal theme (included by ~/.config/ghostty/config)
#   gtk.css        GTK 3/4 colors (imported by ~/.config/gtk-{3,4}.0/gtk.css)
#   qt6ct-colors.conf  Qt colors (qt6ct)
# also ~/.config/btop/themes/orka.theme and ~/.local/share/icons/default/
# index.theme (cursor for X11 apps), and, keeping your other settings there:
# the style, colors and icon theme in ~/.config/qt6ct/qt6ct.conf and
# ~/.config/kdeglobals, the cursor in ~/.config/kcminputrc, gsettings for GTK,
# btop's color_theme in ~/.config/btop/btop.conf (only while it's "Default").
set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/orka"
SETTINGS="$CFG/settings.json"
CURRENT="$CFG/current"
SYSTEM_THEMES=/usr/share/orka/themes
USER_THEMES="$CFG/themes"

mkdir -p "$CFG" "$CURRENT"
[[ -s $SETTINGS ]] || echo '{}' >"$SETTINGS"

setting() { jq -r "$1 // empty" "$SETTINGS" 2>/dev/null; }
in_hyprland() { [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; }

# Start a program detached, in its own scope like the key bindings do.
launch() {
  if command -v uwsm >/dev/null && in_hyprland; then
    setsid -f uwsm app -- "$@" >/dev/null 2>&1
  else
    setsid -f "$@" >/dev/null 2>&1
  fi
}

# Theme id -> its directory (yours replace the built-in ones); unknown: orka.
theme_dir() {
  local d
  for d in "$USER_THEMES/$1" "$SYSTEM_THEMES/$1" "$SYSTEM_THEMES/orka"; do
    [[ -f $d/theme.json ]] && { echo "$d"; return; }
  done
}

write() {  # write <file> (stdin): replace atomically
  cat >"$1.tmp" && mv "$1.tmp" "$1"
}

# --- Dark / light mode ------------------------------------------------------
# settings.json keeps one theme for each mode and which mode is on:
#   "appearance": { "mode": "dark", "dark": "orka", "light": "orka-light" }
# The theme in use is the one of the current mode.

theme_mode() {  # theme_mode <id>: dark or light (from its theme.json)
  local dir
  dir="$(theme_dir "$1")"
  if [[ -n $dir && "$(jq -r '.mode // "dark"' "$dir/theme.json" 2>/dev/null)" == light ]]; then echo light; else echo dark; fi
}

current_mode() { [[ "$(setting .appearance.mode)" == light ]] && echo light || echo dark; }

active_theme() {
  local mode id
  mode="$(current_mode)"
  id="$(setting ".appearance.$mode")"
  if [[ -n $id ]]; then echo "$id"; elif [[ $mode == light ]]; then echo orka-light; else echo orka; fi
}

# Settings from before the dark/light split had one "theme": it becomes the
# theme of its own mode, and that mode is switched on.
migrate_appearance() {
  local legacy mode
  jq -e 'has("theme") or (has("appearance") | not)' "$SETTINGS" >/dev/null 2>&1 || return 0
  legacy="$(setting .theme)"
  mode=dark
  [[ -n $legacy ]] && mode="$(theme_mode "$legacy")"
  jq --arg legacy "$legacy" --arg mode "$mode" '
    .appearance = ({ mode: $mode, dark: "orka", light: "orka-light" }
                   + (if $legacy != "" then { ($mode): $legacy } else {} end)
                   + (.appearance // {}))
    | del(.theme)' "$SETTINGS" | write "$SETTINGS"
}

# mode [dark|light|toggle]: print the mode, or switch it and apply the theme.
mode() {
  local want=${1:-}
  case "$want" in
    "") current_mode; return ;;
    toggle) [[ "$(current_mode)" == dark ]] && want=light || want=dark ;;
    dark|light) ;;
    *) echo "usage: orka-settings mode [dark|light|toggle]" >&2; return 1 ;;
  esac
  jq --arg m "$want" '.appearance.mode = $m' "$SETTINGS" | write "$SETTINGS"
  apply theme
  echo "$want"
}

apply_theme() {
  local id dir ghostty mode
  id="$(active_theme)"
  dir="$(theme_dir "$id")"
  [[ -n $dir ]] || { echo "orka-settings: no themes found" >&2; return 1; }
  jq --arg id "$(basename "$dir")" --arg dir "$dir" '. + { id: $id, dir: $dir }' "$dir/theme.json" | write "$CURRENT/theme.json"

  # Ghostty: the theme's own ghostty.conf, or a built-in Ghostty theme by name.
  if [[ -f $dir/ghostty.conf ]]; then
    write "$CURRENT/ghostty.conf" <"$dir/ghostty.conf"
  else
    ghostty="$(jq -r '.ghostty // ""' "$dir/theme.json")"
    if [[ -n $ghostty ]]; then
      printf '# Generated by orka-settings (theme %s)\ntheme = "%s"\n' "$id" "$ghostty" | write "$CURRENT/ghostty.conf"
    else
      printf '# Generated by orka-settings (theme %s): Ghostty'"'"'s default colors\n' "$id" | write "$CURRENT/ghostty.conf"
    fi
  fi
  pkill -USR2 -x ghostty 2>/dev/null   # Ghostty reloads its config on SIGUSR2

  apply_apps
  return 0
}

# --- GTK, Qt and icons, generated from the theme's colors -----------------

# mix <#a> <#b> <percent of b>: a color between two others, e.g. a surface
# slightly lighter (dark themes) or darker (light themes) than the background.
mix() {
  local a=${1#\#} b=${2#\#} t=$3 i out=
  for i in 0 2 4; do
    out+=$(printf '%02x' $(( (16#${a:i:2} * (100 - t) + 16#${b:i:2} * t + 50) / 100 )))
  done
  echo "#$out"
}
rgb() { local c=${1#\#}; echo "$((16#${c:0:2})),$((16#${c:2:2})),$((16#${c:4:2}))"; }

# ini_merge <file> (stdin: an INI fragment): set those keys in <file> and keep
# everything else (your own settings there, e.g. fonts in qt6ct.conf).
ini_merge() {
  local file=$1 frag
  frag="$(cat)"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  awk -v frag="$frag" '
    BEGIN {
      n = split(frag, lines, "\n")
      for (i = 1; i <= n; i++) {
        if (lines[i] ~ /^\[.*\]$/) { sec = lines[i]; if (!(sec in seen)) { order[++nsec] = sec; seen[sec] = 1 } }
        else if ((p = index(lines[i], "=")) > 0) {
          k = substr(lines[i], 1, p - 1); val[sec, k] = lines[i]
          keys[sec] = keys[sec] SUBSEP k
        }
      }
      sec = ""
    }
    function flush(s,   arr, m, j) {   # keys of section s not in the file yet
      m = split(substr(keys[s], 2), arr, SUBSEP)
      for (j = 1; j <= m; j++) if (!((s, arr[j]) in done)) { print val[s, arr[j]]; done[s, arr[j]] = 1 }
    }
    /^[ \t]*$/ { blank++; next }   # held back, so new keys go before the gap
    /^\[.*\]$/ { if (sec != "") flush(sec); for (; blank > 0; blank--) print ""; sec = $0; present[sec] = 1; print; next }
    {
      for (; blank > 0; blank--) print ""
      if ((p = index($0, "=")) > 0) {
        k = substr($0, 1, p - 1)
        if ((sec, k) in val) { print val[sec, k]; done[sec, k] = 1; next }
      }
      print
    }
    END {
      if (sec != "") flush(sec)
      for (; blank > 0; blank--) print ""
      for (i = 1; i <= nsec; i++) if (!(order[i] in present)) { print ""; print order[i]; flush(order[i]) }
    }' "$file" >"$file.tmp" && mv "$file.tmp" "$file"
}

apply_apps() {
  local t="$CURRENT/theme.json" mode bg fg accent accent2 urgent inactive icons
  local surface window header button tooltip dim
  [[ -f $t ]] || { apply_theme; return; }   # apply_theme calls this again
  mode="$(jq -r '.mode // "dark"' "$t")"
  bg="$(jq -r '.colors.background // "#0d1620"' "$t")"
  fg="$(jq -r '.colors.foreground // "#dce6ef"' "$t")"
  accent="$(jq -r '.colors.accent // "#3fa7d6"' "$t")"
  accent2="$(jq -r '.colors.accent2 // "#7fd1c7"' "$t")"
  urgent="$(jq -r '.colors.urgent // "#ef6461"' "$t")"
  inactive="$(jq -r '.colors.inactive // "#2e3d4d"' "$t")"
  if [[ $mode == light ]]; then icons=Papirus-Light; else icons=Papirus-Dark; fi
  icons="$(jq -r --arg d "$icons" '.icons // $d' "$t")"

  # Surfaces: content areas use the background; window chrome, buttons and
  # popups are a step towards the text color.
  window="$(mix "$bg" "$fg" 4)"
  surface="$(mix "$bg" "$fg" 7)"
  header="$(mix "$bg" "$fg" 9)"
  button="$(mix "$bg" "$fg" 12)"
  tooltip="$(mix "$bg" "$fg" 10)"
  dim="$(mix "$fg" "$bg" 45)"

  # GTK 3 (adw-gtk3) and GTK 4 (libadwaita) named colors. Imported by
  # ~/.config/gtk-{3,4}.0/gtk.css; apps pick it up when they start.
  write "$CURRENT/gtk.css" <<EOF
/* Generated by orka-settings from the current theme. Don't edit. */
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color destructive_color $urgent;
@define-color destructive_bg_color $urgent;
@define-color destructive_fg_color $bg;
@define-color success_color $accent2;
@define-color window_bg_color $window;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $header;
@define-color headerbar_fg_color $fg;
@define-color headerbar_backdrop_color $window;
@define-color sidebar_bg_color $surface;
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color $window;
@define-color secondary_sidebar_bg_color $window;
@define-color secondary_sidebar_fg_color $fg;
@define-color card_bg_color $surface;
@define-color card_fg_color $fg;
@define-color dialog_bg_color $surface;
@define-color dialog_fg_color $fg;
@define-color popover_bg_color $surface;
@define-color popover_fg_color $fg;
@define-color thumbnail_bg_color $surface;
@define-color thumbnail_fg_color $fg;
EOF
  if [[ $mode == light ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3 2>/dev/null
  else
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null
  fi
  gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode" 2>/dev/null
  gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null

  # Qt (qt6ct, QT_QPA_PLATFORMTHEME=qt6ct): a palette in qt6ct's format, 21
  # colors in QPalette::ColorRole order: WindowText Button Light Midlight Dark
  # Mid Text BrightText ButtonText Base Window Shadow Highlight
  # HighlightedText Link LinkVisited AlternateBase NoRole ToolTipBase
  # ToolTipText PlaceholderText.
  local bright=#ffffff off
  [[ $mode == light ]] && bright=#000000
  off="$(mix "$fg" "$bg" 50)"
  palette() {  # palette <text> <selection> <selected text>
    local c out=
    for c in "$1" "$button" "$(mix "$button" "$fg" 15)" "$(mix "$button" "$fg" 8)" "$(mix "$bg" "#000000" 35)" \
             "$(mix "$bg" "$fg" 20)" "$1" "$bright" "$1" "$bg" "$window" "#000000" "$2" \
             "$3" "$accent" "$accent2" "$(mix "$bg" "$fg" 3)" "$bg" "$tooltip" "$fg" "$dim"; do
      out+="#ff${c#\#}, "
    done
    echo "${out%, }"
  }
  # Selections: the accent in the focused window, a soft tint of it with the
  # normal text elsewhere (e.g. Dolphin's sidebar while you're in the files).
  write "$CURRENT/qt6ct-colors.conf" <<EOF
[ColorScheme]
active_colors=$(palette "$fg" "$accent" "$bg")
inactive_colors=$(palette "$fg" "$(mix "$bg" "$accent" 30)" "$fg")
disabled_colors=$(palette "$off" "$(mix "$bg" "$accent" 30)" "$off")
EOF
  ini_merge "${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf" <<EOF
[Appearance]
style=Breeze
custom_palette=true
color_scheme_path=$CURRENT/qt6ct-colors.conf
icon_theme=$icons
EOF

  # KDE apps (Dolphin, Filelight, KDE Connect) also read colors from
  # kdeglobals for their views, sidebars and selections.
  group() {  # group <name> <background> <alternate background> <text>
    printf '[Colors:%s]\nBackgroundNormal=%s\nBackgroundAlternate=%s\nForegroundNormal=%s\nForegroundInactive=%s\n' \
      "$1" "$(rgb "$2")" "$(rgb "$3")" "$(rgb "$4")" "$(rgb "$dim")"
    printf 'ForegroundActive=%s\nForegroundLink=%s\nForegroundVisited=%s\nForegroundNegative=%s\n' \
      "$(rgb "$accent")" "$(rgb "$accent")" "$(rgb "$accent2")" "$(rgb "$urgent")"
    printf 'ForegroundNeutral=%s\nForegroundPositive=%s\nDecorationFocus=%s\nDecorationHover=%s\n' \
      "$(rgb "$accent2")" "$(rgb "$accent2")" "$(rgb "$accent")" "$(rgb "$accent")"
  }
  {
    group View "$bg" "$(mix "$bg" "$fg" 3)" "$fg"
    group Window "$window" "$surface" "$fg"
    group Button "$button" "$surface" "$fg"
    group Header "$header" "$window" "$fg"
    group Tooltip "$tooltip" "$surface" "$fg"
    group Complementary "$window" "$surface" "$fg"
    group Selection "$accent" "$accent" "$bg"
    # Outside Plasma, KDE apps fall back to Breeze Light unless this is set;
    # "*" makes them use the qt6ct palette.
    printf '[UiSettings]\nColorScheme=*\n'
    printf '[Icons]\nTheme=%s\n' "$icons"
    printf '[KDE]\nwidgetStyle=Breeze\n'
  } | ini_merge "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"

  # btop: a theme file in btop's own folder (it only finds themes there),
  # chosen in btop.conf unless you picked another theme in btop.
  local btop="${XDG_CONFIG_HOME:-$HOME/.config}/btop" low
  low="$(mix "$bg" "$fg" 18)"   # start of the meters' gradients: just above the background
  mkdir -p "$btop/themes"
  write "$btop/themes/orka.theme" <<EOF
# Generated by orka-settings from the current OrkaOS theme. Don't edit: it's
# rewritten on every theme change. To use another btop theme, pick it in
# btop's options (ESC → Options); OrkaOS then leaves btop.conf alone.
theme[main_bg]="$bg"
theme[main_fg]="$fg"
theme[title]="$fg"
theme[hi_fg]="$accent"
theme[selected_bg]="$(mix "$bg" "$accent" 30)"
theme[selected_fg]="$fg"
theme[inactive_fg]="$dim"
theme[graph_text]="$dim"
theme[meter_bg]="$inactive"
theme[proc_misc]="$accent2"
theme[cpu_box]="$accent"
theme[mem_box]="$accent2"
theme[net_box]="$accent"
theme[proc_box]="$accent2"
theme[div_line]="$inactive"
theme[temp_start]="$accent2"
theme[temp_mid]="$accent"
theme[temp_end]="$urgent"
theme[cpu_start]="$accent2"
theme[cpu_mid]="$accent"
theme[cpu_end]="$urgent"
theme[free_start]="$low"
theme[free_mid]="$(mix "$low" "$accent2" 50)"
theme[free_end]="$accent2"
theme[cached_start]="$low"
theme[cached_mid]="$(mix "$low" "$accent" 50)"
theme[cached_end]="$accent"
theme[available_start]="$low"
theme[available_mid]="$(mix "$low" "$accent2" 50)"
theme[available_end]="$accent2"
theme[used_start]="$accent2"
theme[used_mid]="$accent"
theme[used_end]="$urgent"
theme[download_start]="$low"
theme[download_mid]="$(mix "$low" "$accent" 50)"
theme[download_end]="$accent"
theme[upload_start]="$low"
theme[upload_mid]="$(mix "$low" "$accent2" 50)"
theme[upload_end]="$accent2"
theme[process_start]="$accent2"
theme[process_mid]="$accent"
theme[process_end]="$urgent"
EOF
  # btop writes btop.conf itself (all keys) on exit; only its theme is set
  # here, and only while it's btop's built-in default.
  local conf="$btop/btop.conf"
  if [[ ! -s $conf ]] || ! grep -q '^color_theme' "$conf"; then
    echo 'color_theme = "orka"' >>"$conf"
  elif grep -Eq '^color_theme *= *"(Default)?"' "$conf"; then
    sed -i 's/^color_theme *=.*/color_theme = "orka"/' "$conf"
  fi
  pkill -USR2 -x btop 2>/dev/null   # a running btop reloads its config and theme

  apply_cursor
  return 0
}

# --- Mouse cursor -----------------------------------------------------------

cursor_theme() { local t; t="$(setting .cursor.theme)"; echo "${t:-Bibata-Modern-Classic}"; }
cursor_size()  { local s; s="$(setting .cursor.size)"; [[ $s =~ ^[0-9]+$ ]] || s=24; echo "$s"; }

# The same cursor in Hyprland, GTK, Qt/KDE and X11 apps. New Hyprland
# sessions get it from XCURSOR_THEME/XCURSOR_SIZE (orka/envs.lua).
apply_cursor() {
  local theme size
  theme="$(cursor_theme)"
  size="$(cursor_size)"
  in_hyprland && hyprctl setcursor "$theme" "$size" >/dev/null
  gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null
  gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null
  printf '[Mouse]\ncursorTheme=%s\ncursorSize=%s\n' "$theme" "$size" \
    | ini_merge "${XDG_CONFIG_HOME:-$HOME/.config}/kcminputrc"
  # Fallback for X11 apps (XWayland) and toolkits that read the "default" theme.
  mkdir -p "$HOME/.local/share/icons/default"
  printf '# Generated by orka-settings (mouse cursor). Don'"'"'t edit.\n[Icon Theme]\nInherits=%s\n' "$theme" \
    | write "$HOME/.local/share/icons/default/index.theme"
  return 0
}

# Theme colors, monitors and keyboard for Hyprland (orka/settings.lua).
apply_hyprland() {
  local theme="$CURRENT/theme.json" accent accent2 inactive monitors input cursor animations
  [[ -f $theme ]] || apply_theme
  rgba() { local hex; hex="$(jq -r "$1 // \"$2\"" "$theme")"; echo "rgba(${hex#\#}$3)"; }
  accent="$(rgba .colors.accent '#3fa7d6' ee)"
  accent2="$(rgba .colors.accent2 '#7fd1c7' ee)"
  inactive="$(rgba .colors.inactive '#2e3d4d' aa)"
  monitors="$(jq -r '(.monitors // {}) | to_entries[] |
    "    { output = \(.key | tojson), mode = \(.value.mode // "preferred" | tojson), position = \(.value.position // "auto" | tojson), scale = \(.value.scale // 1) },"' "$SETTINGS")"
  input="$(jq -r '.keyboard // {} |
    [ (if (.layouts // []) | length > 0 then "kb_layout = \(.layouts | join(",") | tojson)" else empty end),
      (if has("switch") then "kb_options = \(.switch | tojson)" else empty end),
      (if .repeatRate then "repeat_rate = \(.repeatRate)" else empty end),
      (if .repeatDelay then "repeat_delay = \(.repeatDelay)" else empty end) ] | join(", ")' "$SETTINGS")"
  cursor="theme = $(cursor_theme | jq -R .), size = $(cursor_size)"
  # Animations: only known values get through (anything else = the default).
  animations="$(jq -r '.animations // {} |
    "enabled = \(.enabled != false), speed = \((.speed | numbers | if . < 0.2 then 0.2 elif . > 3 then 3 else . end) // 1), " +
    "windows = \((.windows | select(IN("popin", "slide", "gnomed", "fade"))) // "popin" | tojson), " +
    "workspaces = \((.workspaces | select(IN("off", "slide", "slidevert", "fade", "slidefade"))) // "off" | tojson), " +
    "moves = \(.moves != false)"' "$SETTINGS")"
  write "$CURRENT/hyprland.lua" <<EOF
-- Generated by orka-settings from ~/.config/orka/settings.json and the
-- current theme. Don't edit: it's rewritten on every change.
return {
    colors = { accent = "$accent", accent2 = "$accent2", inactive = "$inactive" },
    monitors = {
$monitors
    },
    input = { $input },
    cursor = { $cursor },
    animations = { $animations },
}
EOF
  in_hyprland && hyprctl reload >/dev/null
  return 0
}

apply_wallpaper() {
  in_hyprland && launch orka-wallpaper
  return 0
}

apply_nightlight() {
  local temperature
  temperature="$(setting .nightlight.temperature)"
  pkill -x hyprsunset
  if [[ "$(setting .nightlight.on)" == true ]] && in_hyprland; then
    launch hyprsunset -t "${temperature:-4000}"
  fi
  return 0
}

apply() {
  case "${1:-all}" in
    all)        apply_theme; apply_hyprland; apply_wallpaper; apply_nightlight ;;
    theme)      apply_theme; apply_hyprland; apply_wallpaper ;;
    apps)       apply_apps ;;
    cursor)     apply_cursor ;;
    hyprland)   apply_hyprland ;;
    wallpaper)  apply_wallpaper ;;
    nightlight) apply_nightlight ;;
    none)       ;;
    *) echo "orka-settings: unknown part: $1" >&2; return 1 ;;
  esac
}

themes() {
  local d user
  {
    for d in "$SYSTEM_THEMES"/*/ "$USER_THEMES"/*/; do
      [[ -f $d/theme.json ]] || continue
      [[ $d == "$USER_THEMES"/* ]] && user=true || user=false
      jq -c --arg id "$(basename "$d")" --arg dir "${d%/}" --argjson user "$user" \
        '. + { id: $id, dir: $dir, user: $user }' "$d/theme.json" 2>/dev/null
    done
  } | jq -s 'reverse | unique_by(.id) | sort_by(.name)'
}

# Cursor themes: every folder with a cursors/ inside, yours first (a name in
# ~/.local/share/icons or ~/.icons replaces the system one).
CURSOR_DIRS=("$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons)
PREVIEWS="${XDG_CACHE_HOME:-$HOME/.cache}/orka/cursor-previews"

# Preview images for the settings app (arrow, hand, text, busy), made with
# xcur2png and kept until the theme changes.
cursor_previews() {  # cursor_previews <id> <dir>
  local out="$PREVIEWS/$1" dir=$2 role names n f tmp best
  [[ -f $out/arrow.png && $out/arrow.png -nt $dir/cursors ]] && return
  command -v xcur2png >/dev/null || return
  mkdir -p "$out"
  for role in "arrow:left_ptr default arrow" "hand:pointer hand2 hand1" "text:text xterm ibeam" "busy:watch wait left_ptr_watch"; do
    names=${role#*:}
    f=
    for n in $names; do [[ -e $dir/cursors/$n ]] && { f=$dir/cursors/$n; break; }; done
    [[ -n $f ]] || continue
    tmp="$(mktemp -d)"
    if xcur2png -d "$tmp" -c "$tmp/conf" "$f" >/dev/null 2>&1; then
      # the image closest to 48 px (the first frame of animated ones)
      best="$(awk '!/^#/ && NF >= 4 { d = $1 - 48; if (d < 0) d = -d; if (!seen[$1]++ && (b == "" || d < bd)) { b = $4; bd = d } } END { print b }' "$tmp/conf")"
      [[ -n $best && -f $best ]] && cp "$best" "$out/${role%%:*}.png"
    fi
    rm -rf "$tmp"
  done
  touch "$out/arrow.png" 2>/dev/null   # even if it has no arrow: don't retry every time
}

cursors() {
  local base d id name user
  for base in "${CURSOR_DIRS[@]}"; do
    [[ $base == /usr/share/icons ]] && user=false || user=true
    for d in "$base"/*/; do
      d=${d%/}; id=${d##*/}
      [[ $id != default && -d $d/cursors ]] || continue
      name="$(awk -F= '/^Name=/ { print $2; exit }' "$d/index.theme" 2>/dev/null)"
      cursor_previews "$id" "$d"
      jq -nc --arg id "$id" --arg name "${name:-$id}" --arg dir "$d" --argjson user "$user" \
        --arg previews "$PREVIEWS/$id" '$ARGS.named'
    done
  done | jq -s 'reduce .[] as $t ({}; if has($t.id) then . else .[$t.id] = $t end)
                | [.[]] | sort_by(.name | ascii_downcase)'
}

about() {
  # shellcheck disable=SC1091  # /etc/os-release: only NAME, VERSION and PRETTY_NAME are read
  jq -n \
    --arg os "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-}")" \
    --arg osName "$(. /etc/os-release 2>/dev/null; echo "${NAME:-}")" \
    --arg osVersion "$(. /etc/os-release 2>/dev/null; echo "${VERSION:-}")" \
    --arg host "$(cat /etc/hostname 2>/dev/null)" \
    --arg kernel "$(uname -r)" \
    --arg cpu "$(awk -F': ' '/model name/ { print $2; exit }' /proc/cpuinfo)" \
    --arg gpu "$(lspci 2>/dev/null | awk -F': ' '/VGA|3D|Display/ { print $2 }' | paste -sd ';')" \
    --arg memory "$(free -h | awk '/^Mem:/ { print $3 " used of " $2 }')" \
    --arg disk "$(df -h / | awk 'NR == 2 { print $3 " used of " $2 " (" $5 ")" }')" \
    --arg uptime "$(uptime -p | sed 's/^up //')" \
    --arg hyprland "$(in_hyprland && hyprctl version -j 2>/dev/null | jq -r '.version // empty')" \
    --arg quickshell "$(qs --version 2>/dev/null | head -1 | sed -E 's/^[Qq]uickshell[[:space:]]+([^[:space:]]+).*/\1/')" \
    --arg installed "$(stat -c %w /opt/orka/src 2>/dev/null | cut -d' ' -f1)" \
    '$ARGS.named'
}

case "${1:-}" in
  set|apply|mode|get) migrate_appearance ;;
esac

case "${1:-}" in
  get)
    jq "${2:-.}" "$SETTINGS" ;;
  set)
    [[ $# -eq 3 ]] || { echo "usage: orka-settings set .path <json value>" >&2; exit 1; }
    if [[ $2 == .theme ]]; then
      # The old single theme: it becomes its mode's theme, and that mode is on.
      id="$(jq -r 'strings' <<<"$3")"
      [[ -n $id ]] || { echo "orka-settings: .theme needs a theme id, e.g. '\"orka\"'" >&2; exit 1; }
      m="$(theme_mode "$id")"
      jq --arg id "$id" --arg m "$m" '.appearance[$m] = $id | .appearance.mode = $m' "$SETTINGS" | write "$SETTINGS" || exit 1
    else
      jq --argjson v "$3" "$2 = \$v" "$SETTINGS" | write "$SETTINGS" || exit 1
    fi
    case "$2" in
      .theme*|.appearance*)  apply theme ;;
      .wallpaper*)           apply wallpaper ;;
      .monitors*|.keyboard*|.animations*) apply hyprland ;;
      .cursor*)              apply hyprland; apply_cursor ;;
      .nightlight*)          apply nightlight ;;
    esac ;;
  apply)  apply "${2:-all}" ;;
  mode)    mode "${2:-}" ;;
  themes)  themes ;;
  cursors) cursors ;;
  about)   about ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
