#!/bin/bash
# Start or stop recording the focused monitor (gpu-screen-recorder, AMD VA-API).
# Videos go to ~/Videos/Screenrecordings.
set -euo pipefail
if pkill -INT -f '^gpu-screen-recorder'; then
  exit 0
fi
dir="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Screenrecordings"
mkdir -p "$dir"
output="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
exec gpu-screen-recorder -w "$output" -f 60 -a default_output \
  -o "$dir/recording-$(date +%Y-%m-%d_%H-%M-%S).mp4"
