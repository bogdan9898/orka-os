#!/bin/bash
# Searchable list of all Hyprland key bindings that have a description.
# Number-row bindings use key codes (code:10..19 = 1..0, 20 = -, 21 = =).
hyprctl -j binds | jq -r '
  .[] | select(.description != "") |
  ([ (if .modmask >= 64 then "SUPER" else empty end),
     (if (.modmask % 64) >= 8 then "ALT" else empty end),
     (if (.modmask % 8) >= 4 then "CTRL" else empty end),
     (if (.modmask % 2) == 1 then "SHIFT" else empty end) ] | join(" + ")) as $mods |
  (if .key != "" then .key
   elif .keycode >= 10 and .keycode <= 19 then "\((.keycode - 9) % 10)"
   elif .keycode == 20 then "-"
   elif .keycode == 21 then "="
   else "code:\(.keycode)" end) as $key |
  "\(if $mods == "" then "" else $mods + " + " end)\($key)\t\(.description)"' |
  column -t -s $'\t' | fzf --reverse --no-sort --prompt 'keys> ' --header 'OrkaOS key bindings (Esc to close)'
