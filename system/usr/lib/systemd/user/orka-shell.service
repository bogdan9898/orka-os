# The OrkaOS desktop shell (Quickshell, /usr/share/orka/shell): bar,
# notifications, polkit agent, launcher, lock screen, idle. Started with the
# Hyprland session (uwsm activates graphical-session.target) and restarted if
# it crashes, so a crash while locked locks again at once.
# Enabled for all users: systemctl --global enable orka-shell.service
[Unit]
Description=OrkaOS shell (Quickshell)
Documentation=https://github.com/bogdan9898/orka-os/blob/master/docs/quickshell.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/qs -p /usr/share/orka/shell
# No crash-report dialog (systemd restarts the shell instead) and no
# "configuration reloaded" popup.
Environment=QS_DISABLE_CRASH_HANDLER=1 QS_NO_RELOAD_POPUP=1
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
