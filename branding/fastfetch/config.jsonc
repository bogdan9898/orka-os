// OrkaOS: fastfetch defaults (installed as /etc/xdg/fastfetch/config.jsonc;
// your own ~/.config/fastfetch/config.jsonc replaces it).
// The logo is an image, white (Ghostty shows it with the kitty graphics
// protocol); elsewhere (the text consoles) OrkaOS's `fastfetch` shell
// function switches to --logo-type chafa, the logo drawn with characters.
// Labels use the terminal's blue, which the OrkaOS themes set to the theme's
// accent color.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/orka/branding/fastfetch/orkaos.png",
    "width": 30,
    "height": 15,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "blue" },
    "key": { "width": 11 },
    "bar": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "format": "{name} {version} {arch}" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "display", "key": "Display" },
    { "type": "wm", "key": "WM" },
    {
      "type": "command",
      "key": "Theme",
      "text": "printf '%s (%s mode)' \"$(jq -r '.name // empty' \"${XDG_CONFIG_HOME:-$HOME/.config}/orka/current/theme.json\" 2>/dev/null)\" \"$(orka-settings mode 2>/dev/null)\""
    },
    "icons",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
